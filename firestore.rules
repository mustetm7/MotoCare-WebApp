rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Strict Zero-Trust Admin Verification:
    // Checks verified owner email first to short-circuit the exists() read when the owner is signed in.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == "mustetm7@gmail.com" ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    // Authoritative Server-Time Pro Entitlement Check:
    // Uses Firestore server time (`request.time`) against a native Firestore Timestamp `expiryDate`.
    function isUserPro(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return exists(userPath) &&
        get(userPath).data.subscriptionTier == 'pro' &&
        (
          !('subscriptionStatus' in get(userPath).data) ||
          get(userPath).data.subscriptionStatus == 'active'
        ) &&
        ('expiryDate' in get(userPath).data) &&
        get(userPath).data.expiryDate is timestamp &&
        get(userPath).data.expiryDate > request.time;
    }

    // ===============================================================
    // Monotonic cloudVersion Validation Helpers
    // ===============================================================
    function isValidCloudVersionCreate(data) {
      return ('cloudVersion' in data) &&
        data.cloudVersion is int &&
        data.cloudVersion == 1;
    }

    function isValidCloudVersionUpdate(newData, oldData) {
      return ('cloudVersion' in newData) &&
        newData.cloudVersion is int &&
        (
          (!('cloudVersion' in oldData) && newData.cloudVersion == 1) ||
          (
            ('cloudVersion' in oldData) &&
            oldData.cloudVersion is int &&
            oldData.cloudVersion >= 1 &&
            newData.cloudVersion == oldData.cloudVersion + 1
          )
        );
    }

    // ===============================================================
    // Schema & Field Allow-List Helpers
    // ===============================================================
    function isValidUserCreate(userId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id', 'uid', 'email', 'displayName', 'photoURL',
          'role', 'subscriptionTier', 'subscriptionStatus', 'paymentStatus',
          'bikeCount', 'lastBikeId', 'lastBikeAction', 'pendingSubmissionId',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ]) &&
        data.id == userId &&
        data.role == 'rider' &&
        data.subscriptionTier == 'free' &&
        (!('subscriptionStatus' in data) || data.subscriptionStatus == 'free') &&
        (!('paymentStatus' in data) || data.paymentStatus == 'unpaid_free') &&
        (!('bikeCount' in data) || data.bikeCount == 0) &&
        (
          !('pendingSubmissionId' in data) ||
          data.pendingSubmissionId == null ||
          (
            data.pendingSubmissionId is string &&
            data.pendingSubmissionId.size() > 0 &&
            data.pendingSubmissionId.size() <= 128 &&
            existsAfter(/databases/$(database)/documents/paymentSubmissions/$(data.pendingSubmissionId)) &&
            getAfter(/databases/$(database)/documents/paymentSubmissions/$(data.pendingSubmissionId)).data.userId == userId &&
            getAfter(/databases/$(database)/documents/paymentSubmissions/$(data.pendingSubmissionId)).data.status == 'pending_approval'
          )
        );
    }

    function isValidPendingSubmissionTransition(userId) {
      let touchesPending = request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingSubmissionId']);
      return !touchesPending ||
        (
          // Setting a new pending submission when none is currently active
          (!('pendingSubmissionId' in resource.data) || resource.data.pendingSubmissionId == null) &&
          request.resource.data.pendingSubmissionId is string &&
          request.resource.data.pendingSubmissionId.size() > 0 &&
          request.resource.data.pendingSubmissionId.size() <= 128 &&
          existsAfter(/databases/$(database)/documents/paymentSubmissions/$(request.resource.data.pendingSubmissionId)) &&
          getAfter(/databases/$(database)/documents/paymentSubmissions/$(request.resource.data.pendingSubmissionId)).data.userId == userId &&
          getAfter(/databases/$(database)/documents/paymentSubmissions/$(request.resource.data.pendingSubmissionId)).data.status == 'pending_approval'
        ) ||
        (
          // Clearing pendingSubmissionId when the user deletes their own pending submission
          request.resource.data.pendingSubmissionId == null &&
          ('pendingSubmissionId' in resource.data) &&
          resource.data.pendingSubmissionId is string &&
          !existsAfter(/databases/$(database)/documents/paymentSubmissions/$(resource.data.pendingSubmissionId))
        );
    }

    function isValidBikeCounterTransition(userId) {
      let touchesBikeCount = request.resource.data.diff(resource.data).affectedKeys().hasAny(['bikeCount', 'lastBikeId', 'lastBikeAction']);
      return !touchesBikeCount ||
        (
          // Atomic Create Check:
          request.resource.data.lastBikeAction == 'create' &&
          request.resource.data.bikeCount == (('bikeCount' in resource.data) ? resource.data.bikeCount : 0) + 1 &&
          request.resource.data.lastBikeId is string &&
          request.resource.data.lastBikeId.size() > 0 &&
          request.resource.data.lastBikeId.size() <= 128 &&
          !exists(/databases/$(database)/documents/motorcycles/$(request.resource.data.lastBikeId)) &&
          existsAfter(/databases/$(database)/documents/motorcycles/$(request.resource.data.lastBikeId)) &&
          getAfter(/databases/$(database)/documents/motorcycles/$(request.resource.data.lastBikeId)).data.userId == userId
        ) ||
        (
          // Atomic Delete Check:
          request.resource.data.lastBikeAction == 'delete' &&
          request.resource.data.bikeCount == (
            (('bikeCount' in resource.data) && resource.data.bikeCount > 0)
              ? resource.data.bikeCount - 1
              : 0
          ) &&
          request.resource.data.lastBikeId is string &&
          request.resource.data.lastBikeId.size() > 0 &&
          request.resource.data.lastBikeId.size() <= 128 &&
          exists(/databases/$(database)/documents/motorcycles/$(request.resource.data.lastBikeId)) &&
          get(/databases/$(database)/documents/motorcycles/$(request.resource.data.lastBikeId)).data.userId == userId &&
          !existsAfter(/databases/$(database)/documents/motorcycles/$(request.resource.data.lastBikeId))
        );
    }

    // Riders can update their display profile, atomic bike counter, or pendingSubmissionId,
    // NEVER their role, subscriptionTier, expiryDate, or billing attributes.
    function isValidUserUpdate(userId) {
      let data = request.resource.data;
      let affected = data.diff(resource.data).affectedKeys();
      return data.keys().hasOnly([
          'id', 'uid', 'email', 'displayName', 'photoURL',
          'role', 'subscriptionTier', 'subscriptionStatus', 'paymentStatus',
          'bikeCount', 'lastBikeId', 'lastBikeAction', 'pendingSubmissionId',
          'lastPaymentId', 'subscriptionStartDate', 'expiryDate', 'billingAnchorDay',
          'approvedAt', 'approvedBy', 'revokedAt', 'revokedBy',
          'createdAt', 'updatedAt', 'lastLoginAt'
        ]) &&
        affected.hasOnly([
          'id', 'uid', 'displayName', 'photoURL',
          'bikeCount', 'lastBikeId', 'lastBikeAction',
          'pendingSubmissionId', 'updatedAt', 'lastLoginAt'
        ]) &&
        data.id == userId &&
        data.role == resource.data.role &&
        data.subscriptionTier == resource.data.subscriptionTier &&
        isValidBikeCounterTransition(userId) &&
        isValidPendingSubmissionTransition(userId);
    }

    function isValidMotorcyclePayload(data, bikeId) {
      return data.keys().hasOnly([
          'id', 'userId', 'nickname', 'brand', 'model', 'year',
          'licensePlate', 'odometer', 'lastOdometerUpdate', 'unit',
          'color', 'customColorBadge', 'photoUrl', 'specs',
          'registrationExpiryDate', 'acquisitionDate', 'motorcycleType',
          'isCustom', 'cloudVersion', 'createdAt', 'updatedAt', 'timestampSource'
        ]) &&
        data.id == bikeId &&
        bikeId.size() > 0 &&
        bikeId.size() <= 128 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000));
    }

    function isValidMotorcycleCreate(bikeId) {
      let data = request.resource.data;
      return isSignedIn() &&
        isValidMotorcyclePayload(data, bikeId) &&
        data.userId == request.auth.uid &&
        isValidCloudVersionCreate(data);
    }

    function isValidReminderPayload(data, reminderId) {
      return data.keys().hasOnly([
          'id', 'userId', 'bikeId', 'title', 'category', 'categoryTag',
          'intervalKm', 'intervalMonths', 'lastCompletedOdo', 'nextDueOdo',
          'lastCompletedDate', 'nextDueDate', 'priority', 'notes', 'manualSpecNote',
          'estimatedCostPhp', 'cloudVersion', 'createdAt', 'updatedAt', 'timestampSource'
        ]) &&
        data.id == reminderId &&
        reminderId.size() > 0 &&
        reminderId.size() <= 128 &&
        data.bikeId is string &&
        data.bikeId.size() > 0 &&
        data.bikeId.size() <= 128 &&
        exists(/databases/$(database)/documents/motorcycles/$(data.bikeId)) &&
        get(/databases/$(database)/documents/motorcycles/$(data.bikeId)).data.userId == request.auth.uid;
    }

    function isValidPartsList(data) {
      return !('parts' in data) ||
        (
          data.parts is list && data.parts.size() <= 50 &&
          (
            data.parts.size() == 0 ||
            (
              data.parts[0] is map &&
              data.parts[0].keys().hasOnly(['name', 'costPhp']) &&
              data.parts[0].name is string &&
              data.parts[0].name.size() <= 200 &&
              data.parts[0].costPhp is number
            )
          )
        );
    }

    function isValidServiceRecordPayload(data, recordId) {
      return data.keys().hasOnly([
          'id', 'userId', 'bikeId', 'date', 'odometer', 'title',
          'category', 'type', 'shopName', 'mechanicName', 'oilBrandGrade',
          'casaVerified', 'isCasaVerified', 'receiptNumber', 'linkedReminderId', 'bikeLabelSnapshot',
          'parts', 'laborCostPhp', 'totalCostPhp',
          'notes', 'nextDueOdometer', 'nextDueDate', 'photoUrl',
          'cloudVersion', 'createdAt', 'updatedAt', 'timestampSource'
        ]) &&
        data.id == recordId &&
        recordId.size() > 0 &&
        recordId.size() <= 128 &&
        data.bikeId is string &&
        data.bikeId.size() > 0 &&
        data.bikeId.size() <= 128 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 2000)) &&
        isValidPartsList(data) &&
        (
          !exists(/databases/$(database)/documents/motorcycles/$(data.bikeId)) ||
          get(/databases/$(database)/documents/motorcycles/$(data.bikeId)).data.userId == request.auth.uid
        );
    }

    // ===============================================================
    // 1. Admins Registry (/admins/{adminId})
    // ===============================================================
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // ===============================================================
    // 2. Users Collection (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && isValidUserCreate(userId)) || isAdmin();
      allow update: if (isOwner(userId) && isValidUserUpdate(userId)) || isAdmin();
      allow delete: if (isOwner(userId) && (!('bikeCount' in resource.data) || resource.data.bikeCount == 0)) || isAdmin();
    }

    // ===============================================================
    // 3. Motorcycles Collection (/motorcycles/{bikeId})
    // ===============================================================
    match /motorcycles/{bikeId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      // Server-enforced Motorcycle Creation & Subscription Quota:
      // Cheap owner & quota checks are evaluated before isAdmin() to avoid unnecessary exists() reads.
      allow create: if isValidMotorcycleCreate(bikeId) &&
        !exists(/databases/$(database)/documents/motorcycles/$(bikeId)) &&
        (
          (
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastBikeAction == 'create' &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastBikeId == bikeId &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.bikeCount ==
              (
                (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 ('bikeCount' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data))
                  ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bikeCount
                  : 0
              ) + 1 &&
            (
              isUserPro(request.auth.uid) ||
              !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              !('bikeCount' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bikeCount < 1
            )
          ) ||
          isAdmin()
        );

      allow update: if isValidCloudVersionUpdate(request.resource.data, resource.data) &&
        isValidMotorcyclePayload(request.resource.data, bikeId) &&
        (
          (
            isOwner(resource.data.userId) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.userId == resource.data.userId
          ) ||
          isAdmin()
        );

      // Server-enforced Motorcycle Deletion & Counter Decrement:
      allow delete: if isSignedIn() &&
        (
          (
            resource.data.userId == request.auth.uid &&
            exists(/databases/$(database)/documents/motorcycles/$(bikeId)) &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastBikeAction == 'delete' &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastBikeId == bikeId &&
            getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.bikeCount ==
              (
                (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                 ('bikeCount' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
                 get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bikeCount > 0)
                  ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.bikeCount - 1
                  : 0
              )
          ) ||
          isAdmin()
        );
    }

    // ===============================================================
    // 4. Maintenance Reminders Collection (/reminders/{reminderId})
    // ===============================================================
    match /reminders/{reminderId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() &&
        isValidReminderPayload(request.resource.data, reminderId) &&
        isValidCloudVersionCreate(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isValidCloudVersionUpdate(request.resource.data, resource.data) &&
        isValidReminderPayload(request.resource.data, reminderId) &&
        (
          (
            isOwner(resource.data.userId) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.bikeId == resource.data.bikeId
          ) ||
          isAdmin()
        );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ===============================================================
    // 5. Service Records Collection (/serviceRecords/{recordId})
    // ===============================================================
    match /serviceRecords/{recordId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() &&
        isValidServiceRecordPayload(request.resource.data, recordId) &&
        isValidCloudVersionCreate(request.resource.data) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isValidCloudVersionUpdate(request.resource.data, resource.data) &&
        isValidServiceRecordPayload(request.resource.data, recordId) &&
        (
          (
            isOwner(resource.data.userId) &&
            request.resource.data.id == resource.data.id &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.bikeId == resource.data.bikeId
          ) ||
          isAdmin()
        );
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ===============================================================
    // 6. Payment Submissions (/paymentSubmissions/{submissionId})
    // ===============================================================
    match /paymentSubmissions/{submissionId} {
      allow get: if isOwner(resource.data.userId) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();

      // Riders can only create pending submissions for themselves with a verified email,
      // an atomic reservation in /paymentReferences/{refHash}, and a single pendingSubmissionId lock on /users/{uid}.
      allow create: if isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName', 'bikeModel', 'bikePlate',
          'paymentMethod', 'referenceNumber', 'referenceHash',
          'amountPhp', 'status', 'submittedAt', 'notes'
        ]) &&
        request.resource.data.id == submissionId &&
        submissionId.size() > 0 &&
        submissionId.size() <= 128 &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.userEmail is string &&
        request.resource.data.userEmail.size() <= 200 &&
        request.resource.data.userName is string &&
        request.resource.data.userName.size() <= 200 &&
        request.resource.data.bikeModel is string &&
        request.resource.data.bikeModel.size() <= 200 &&
        (!('bikePlate' in request.resource.data) || (request.resource.data.bikePlate is string && request.resource.data.bikePlate.size() <= 200)) &&
        (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 200)) &&
        request.resource.data.status == 'pending_approval' &&
        request.resource.data.amountPhp == 49 &&
        request.resource.data.paymentMethod in ['gcash', 'gotyme'] &&
        request.resource.data.referenceNumber is string &&
        request.resource.data.referenceNumber.size() >= 8 &&
        request.resource.data.referenceNumber.size() <= 64 &&
        request.resource.data.referenceHash is string &&
        request.resource.data.referenceHash.size() > 0 &&
        !exists(/databases/$(database)/documents/paymentReferences/$(request.resource.data.referenceHash)) &&
        existsAfter(/databases/$(database)/documents/paymentReferences/$(request.resource.data.referenceHash)) &&
        getAfter(/databases/$(database)/documents/paymentReferences/$(request.resource.data.referenceHash)).data.submissionId == submissionId &&
        (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          !('pendingSubmissionId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pendingSubmissionId == null
        ) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.pendingSubmissionId == submissionId;

      // Only Admins can approve or reject submissions, and only while status is 'pending_approval'.
      allow update: if isAdmin() &&
        resource.data.status == 'pending_approval' &&
        request.resource.data.status in ['active_pro', 'rejected'] &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.referenceHash == resource.data.referenceHash &&
        request.resource.data.amountPhp == resource.data.amountPhp &&
        (
          request.resource.data.status == 'rejected' ||
          (
            request.resource.data.status == 'active_pro' &&
            getAfter(/databases/$(database)/documents/users/$(resource.data.userId)).data.subscriptionTier == 'pro' &&
            getAfter(/databases/$(database)/documents/users/$(resource.data.userId)).data.lastPaymentId == submissionId &&
            getAfter(/databases/$(database)/documents/users/$(resource.data.userId)).data.expiryDate is timestamp &&
            getAfter(/databases/$(database)/documents/users/$(resource.data.userId)).data.expiryDate > request.time
          )
        );

      allow delete: if (isOwner(resource.data.userId) && resource.data.status == 'pending_approval') || isAdmin();
    }

    // ===============================================================
    // 7. Payment Reference Uniqueness Index (/paymentReferences/{refHash})
    // ===============================================================
    match /paymentReferences/{refHash} {
      allow get, list, update, delete: if isAdmin();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['id', 'status', 'createdAt', 'submissionId']) &&
        request.resource.data.id == refHash &&
        request.resource.data.status == 'reserved' &&
        request.resource.data.submissionId is string &&
        request.resource.data.submissionId.size() > 0 &&
        request.resource.data.submissionId.size() <= 128 &&
        existsAfter(/databases/$(database)/documents/paymentSubmissions/$(request.resource.data.submissionId)) &&
        getAfter(/databases/$(database)/documents/paymentSubmissions/$(request.resource.data.submissionId)).data.referenceHash == refHash &&
        getAfter(/databases/$(database)/documents/paymentSubmissions/$(request.resource.data.submissionId)).data.userId == request.auth.uid;
    }

    // Note: Firestore denies all unmatched paths by default.
  }
}
